# Copy to .env and fill in what you need. .env is git-ignored and never logged.

# Optional Semantic Scholar API key (request one at https://www.semanticscholar.org/product/api).
# Without a key, requests use the shared unauthenticated pool and may be throttled (HTTP 429).
S2_API_KEY=

# Where paperscout keeps its SQLite database, cache, reports, and note scaffolds.
# Default: %LOCALAPPDATA%\paperscout on Windows, ~/.local/share/paperscout elsewhere.
# PAPERSCOUT_HOME=./data

# Minimum seconds between Semantic Scholar requests (client-side pacing).
# PAPERSCOUT_S2_MIN_INTERVAL=1.1

# Maximum retries on 429 / 5xx responses (exponential backoff, honours Retry-After).
# PAPERSCOUT_S2_MAX_RETRIES=4

# Default "recent" window in days (a product default, not a definition of "recent").
# PAPERSCOUT_RECENT_DAYS=90

# Optional, disabled by default: programmatic Anthropic API mode is NOT implemented in Phase 1.
# Claude Code (your existing login) does the interpretation; no API credits are required.
# ANTHROPIC_API_KEY=
