# Copy to .env and fill in what you need. .env is git-ignored and never logged.

# Optional Semantic Scholar API key. Apply via https://www.semanticscholar.org/product/api#api-key-form
# (approval and limits are decided by Semantic Scholar). Without a key, requests use the shared
# unauthenticated pool, which is often throttled (HTTP 429), so paperscout uses arXiv instead
# (see PAPERSCOUT_PROVIDER). Never commit or share this value.
S2_API_KEY=

# Paper source: auto (default) = Semantic Scholar when S2_API_KEY is set, otherwise arXiv.
# arxiv needs no key (arXiv preprints only; no citations/recommendations); semantic-scholar = full graph.
# PAPERSCOUT_PROVIDER=auto

# arXiv pacing: never below 3 s (arXiv API terms of use), and max HTTP attempts per command.
# PAPERSCOUT_ARXIV_MIN_INTERVAL=3
# PAPERSCOUT_ARXIV_MAX_REQUESTS=10

# OpenAlex (CC0): citation counts for papers whose provider has none (arXiv), sending only paper identifiers
# (DOIs) and a few titles; and /authors, sending the researcher names and affiliation you give it.
# PAPERSCOUT_OPENALEX=on
# PAPERSCOUT_OPENALEX_MAX_REQUESTS=10

# Optional free OpenAlex API key from https://openalex.org/settings/api. Without it, OpenAlex requests share a
# small daily allowance with everyone on your network; with it, you get your own. It is sent as the api_key
# parameter and never cached, logged or shown. Never commit or share this value.
OPENALEX_API_KEY=

# Where /download saves PDFs (default: your Downloads folder, under paperscout/). Point it at a folder your
# tablet syncs if you like. PDFs are for personal use only; arXiv's terms don't allow redistributing them.
# PAPERSCOUT_DOWNLOAD_DIR=
# PAPERSCOUT_DOWNLOAD_MAX_MB=100

# Where paperscout keeps its SQLite database, cache, reports, and note scaffolds.
# Default: %LOCALAPPDATA%\paperscout on Windows, ~/.local/share/paperscout elsewhere.
# PAPERSCOUT_HOME=./data

# Minimum seconds between Semantic Scholar requests (client-side pacing).
# PAPERSCOUT_S2_MIN_INTERVAL=1.1

# Maximum retries on 429 / 5xx responses (exponential backoff, honours Retry-After).
# Default: 2 without a key (fail fast on the shared pool), 3 with a key.
# PAPERSCOUT_S2_MAX_RETRIES=2

# Hard cap on HTTP attempts per command (retries included). Nothing is sent beyond it.
# PAPERSCOUT_S2_MAX_REQUESTS=40

# Default "recent" window in days (a product default, not a definition of "recent").
# PAPERSCOUT_RECENT_DAYS=90

# Optional, disabled by default: programmatic Anthropic API mode is NOT implemented in Phase 1.
# Claude Code (your existing login) does the interpretation; no API credits are required.
# ANTHROPIC_API_KEY=
